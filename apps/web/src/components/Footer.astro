---
import { site } from "@/data/site";
import Brand from "@/components/Brand.astro";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <Brand footer />
    <p>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <span class="sep" aria-hidden="true">·</span>
      <a href={site.linkedin} rel="me noopener" target="_blank">linkedin</a>
      <span class="sep" aria-hidden="true">·</span>
      <a href={site.github} rel="me noopener" target="_blank">github</a>
      <span class="sep" aria-hidden="true">·</span>
      <a href={site.repo} rel="noopener" target="_blank">source of this site</a>
    </p>
    <p>© {year} {site.fullName} · {site.location}</p>
  </div>
</footer>
