---
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"work">;
  index: number;
}

const { entry, index } = Astro.props;
const { title, summary, period, stack } = entry.data;
---

<li>
  <a href={`/work/${entry.id}`}>
    <span class="index">{String(index).padStart(2, "0")}</span>
    <h3>{title}</h3>
    <p class="summary">{summary}</p>
    <span class="meta">{period}<br />{stack.slice(0, 3).join(" · ")}</span>
  </a>
</li>
