---
import Base from "@/layouts/Base.astro";
---

<Base title="Page not found" description="This page does not exist." noindex>
  <section class="hero">
    <div class="wrap narrow">
      <p class="label">404</p>
      <h1>Nothing at this address.</h1>
      <p class="lead">The link is old or mistyped.</p>
      <p class="cta-row"><a class="btn" href="/">Back to the home page</a></p>
    </div>
  </section>
</Base>
