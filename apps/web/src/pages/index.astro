---
import { getCollection } from "astro:content";
import ContactForm from "@/components/ContactForm.astro";
import StatusLine from "@/components/StatusLine.astro";
import WorkCard from "@/components/WorkCard.astro";
import { artefacts, experience, hero, ownProducts, site, stack } from "@/data/site";
import Base from "@/layouts/Base.astro";

const work = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
---

<Base>
  <section class="hero">
    <div class="wrap">
      <p class="label">{site.name} · {site.location} · UTC+4</p>
      <h1>{hero.who}</h1>
      <p class="lead">{hero.now}</p>
      <div class="cta-row">
        <a class="btn" href="#contact">Start a conversation</a>
        <a class="btn btn-ghost" href={site.cv} download>Download CV</a>
        <a class="btn btn-ghost" href={site.github} rel="me noopener" target="_blank">GitHub</a>
        <a class="btn btn-ghost" href={site.linkedin} rel="me noopener" target="_blank">LinkedIn</a>
      </div>
      <StatusLine />
    </div>
  </section>

  <section id="work" class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Work</h2>
        <span class="mono">{String(work.length).padStart(2, "0")} write-ups · architecture · failure modes · decisions</span>
      </div>
      <ol class="work-list">
        {work.map((entry, i) => <WorkCard entry={entry} index={i + 1} />)}
      </ol>
      <ul class="own-products">
        {
          ownProducts.map((p) => (
            <li>
              <strong>{p.title}</strong>
              {p.text}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="how" class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>How I work</h2>
        <span class="mono">the actual artefacts, not principles</span>
      </div>
      <div class="artefacts">
        {
          artefacts.map((a) => (
            <article class="artefact">
              <header>
                <span>{a.title}</span>
                <span>{a.meta}</span>
              </header>
              <pre set:html={a.body} />
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="experience" class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Experience</h2>
        <span class="mono">2019 — now</span>
      </div>
      <ol class="timeline">
        {
          experience.map((job) => (
            <li>
              <span class="when">{job.period}</span>
              <h3 class="role">
                {job.role} <span>· {job.company}</span>
              </h3>
              <p>{job.summary}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Stack</h2>
        <span class="mono">what I reach for, in order</span>
      </div>
      <dl class="stack">
        {
          stack.map((g) => (
            <div>
              <dt>{g.group}</dt>
              <dd>{g.items.join(" · ")}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section id="contact" class="section">
    <div class="wrap narrow">
      <div class="section-head">
        <h2>Contact</h2>
        <span class="mono">reply within one business day</span>
      </div>
      <p class="muted">
        Tell me what you are building and what is getting in the way. You get questions or a first
        plan back, not a sales call.
      </p>
      <ContactForm />
    </div>
  </section>
</Base>
