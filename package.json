{
  "name": "portfolio",
  "private": true,
  "version": "2.0.0",
  "description": "Harut Aristakesyan — personal site on AWS (S3 + CloudFront, one Lambda for the contact form)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @portfolio/web dev",
    "build": "pnpm -r --filter './apps/*' build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "check:ci": "biome ci .",
    "bundle": "pnpm --filter @portfolio/infra bundle",
    "synth": "pnpm --filter @portfolio/infra synth",
    "diff": "pnpm --filter @portfolio/infra diff",
    "deploy": "pnpm --filter @portfolio/infra deploy",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^22.15.0",
    "lefthook": "^1.13.0",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook",
      "sharp"
    ]
  }
}
