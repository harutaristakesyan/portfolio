{
  "name": "portfolio",
  "private": true,
  "version": "2.0.0",
  "description": "Harut Aristakesyan — personal site on AWS (S3 + CloudFront, one Lambda for the contact form)",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @portfolio/web dev",
    "build": "pnpm -r --filter './apps/*' build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "check:ci": "biome ci .",
    "bundle": "pnpm --filter @portfolio/infra bundle",
    "synth": "pnpm --filter @portfolio/infra synth",
    "diff": "pnpm --filter @portfolio/infra diff",
    "deploy": "pnpm --filter @portfolio/infra deploy",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@types/node": "^24.19.2",
    "lefthook": "^2.2.2",
    "typescript": "^6.0.3"
  }
}
